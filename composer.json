{
    "name": "rank212/laravel-seo",
    "description": "Zero-friction Headless SEO Automation Client Package for Laravel E-Commerce Stores",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rank212 Team",
            "email": "dev@rank212.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Rank212\\LaravelSeo\\": "src/",
            "SeoSaas\\LaravelSeo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rank212\\LaravelSeo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SeoSaas\\LaravelSeo\\SeoServiceProvider"
            ],
            "aliases": {
                "SeoClient": "SeoSaas\\LaravelSeo\\Facades\\SeoClient"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
